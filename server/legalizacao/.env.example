# Copie este arquivo para ".env" na mesma pasta e preencha os valores reais.
# O ".env" de verdade é git-ignored — nunca commite tokens aqui.

# Endpoint real (confirmado 17/09/2026) — a doc oficial fala em
# http://IP_CERTISEGURO:8090/apicertiseguro, mas pra instalação em modo NUVEM
# (ver certiseguro.Certi no perfil do usuário) isso só redireciona pro domínio
# público em HTTPS padrão. Exige o IP de origem cadastrado em "IPs Remotos
# Permitidos" no painel CertiSeguro → Configurações → Configurar API.
CERTISEGURO_URL=https://app.certiseguro.com.br/apicertiseguro
CERTISEGURO_TOKEN=coloque_o_vToken_aqui
CERTISEGURO_CNPJ=00000000000000

# Token compartilhado com o Render — precisa ser IGUAL à variável
# CERTISEGURO_SYNC_TOKEN configurada em Render → Environment. Gere um valor
# aleatório longo (ex.: openssl rand -hex 32) e use o mesmo nos dois lados.
CERTISEGURO_SYNC_TOKEN=

# URL do sistema Grupo-E na nuvem (Render).
APP_URL=https://grupo-e-sistema-uc2w.onrender.com
