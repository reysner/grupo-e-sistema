# server/arquivoMorto/.env  — copie pra .env e preencha (NÃO vai pro git)

# Token da API do Acessórias (o mesmo usado pelo sistema)
ACESSORIAS_API_TOKEN=

# Data de corte: só arquiva empresa cujo "Cliente até" seja >= isso (AAAA-MM-DD)
ARQUIVO_MORTO_DESDE=2026-09-20

# Raiz do servidor de arquivos local (caminho UNC — não depende do mapeamento Z:)
ARQUIVO_MORTO_UNC_ROOT=\\192.168.251.13\escritorial$\UNIDADE ORGANIZACIONAL

# Raiz do Google Drive para Desktop (onde ficam os Drives Compartilhados)
ARQUIVO_MORTO_DRIVE_MOUNT=H:\Drives compartilhados

# 3º destino: backup local no Desktop (mesma estrutura por faixa do Drive).
# Opcional — se não preencher, usa C:\Users\Grupo e\Desktop\BACKUP ARQUIVO MORTO
ARQUIVO_MORTO_BACKUP_DESKTOP=C:\Users\Grupo e\Desktop\BACKUP ARQUIVO MORTO

# Resumo diário por e-mail
ARQUIVO_MORTO_EMAIL_TO=reysner@escritorial.com.br
GMAIL_USER=
GMAIL_APP_PASS=
